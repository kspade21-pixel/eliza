{
  "schemaVersion": 1,
  "ledgerVersion": "2026-08-29.1",
  "effects": [
    {
      "id": "agent-image",
      "workflow": "build-agent-image.yml",
      "surfaces": ["canonical", "cloud", "docker"],
      "shaInput": "source_sha",
      "inputs": { "publication_target": "canonical" }
    },
    {
      "id": "cloud-staging",
      "workflow": "cloud-cf-deploy.yml",
      "surfaces": ["canonical", "cloud", "quality", "ui-core"],
      "shaInput": "source_sha",
      "inputs": { "environment": "staging", "force": "false" }
    },
    {
      "id": "apps-worker-staging",
      "workflow": "deploy-apps-worker.yml",
      "surfaces": ["canonical", "cloud"],
      "shaInput": "source_sha",
      "inputs": { "environment": "staging" }
    },
    {
      "id": "provisioning-worker-staging",
      "workflow": "deploy-eliza-provisioning-worker.yml",
      "surfaces": ["canonical", "cloud"],
      "shaInput": "deployment_sha",
      "inputs": { "environment": "staging" }
    },
    {
      "id": "paper-status",
      "workflow": "paper-nightly.yml",
      "surfaces": ["canonical", "cloud", "quality"],
      "shaInput": "source_sha",
      "bindSourceSha": true,
      "inputs": {}
    }
  ],
  "promotion": {
    "id": "main-promotion",
    "sourceBranch": "develop",
    "targetBranch": "main"
  }
}
